# Copia este archivo como .env y llena los valores.
# Supabase → Project Settings → API (usa la llave pública: anon / publishable)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_o_publishable_key

# Proveedores OAuth que mostrará el login (deben estar activados en Supabase)
VITE_OAUTH_PROVIDERS=github,google
