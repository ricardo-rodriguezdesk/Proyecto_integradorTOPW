# Copia este archivo como .env y llena los valores.
# ⚠️ Nunca subas el .env a GitHub: la service role key salta la seguridad (RLS).

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_o_secret_key

# TMDb → https://www.themoviedb.org/settings/api  (usa UNO de los dos)
TMDB_READ_TOKEN=tu_api_read_access_token_v4
TMDB_API_KEY=
TMDB_PAGES=10

# OpenWeather → https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=tu_api_key
# Cuántas ciudades consultar (0 = todas las capitales + ciudades extra)
WEATHER_LIMIT=0
# Pausa entre peticiones (el plan gratuito permite 60 por minuto)
WEATHER_DELAY_MS=1100

# SWAPI (opcional: si swapi.dev falla se usa el espejo automáticamente)
SWAPI_BASE_URL=https://swapi.dev/api
